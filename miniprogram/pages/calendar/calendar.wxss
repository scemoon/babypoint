/* calendar.wxss - 日历页 */
.calendar-page { padding-top: 24rpx; }

/* 孩子切换器 */
.child-strip { width: calc(100% + 56rpx); margin-left: -28rpx; white-space: nowrap; }
.child-strip-inner { display: flex; gap: 10rpx; padding: 8rpx 28rpx; }
.child-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 22rpx;
  transition: all .15s ease;
}
.child-pill.active {
  background: var(--ink);
  border-color: var(--ink);
  color: #FFF;
}

/* 月份导航 */
.month-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.month-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: var(--soft-water);
  color: var(--ink);
  font-size: 42rpx;
  transition: opacity .12s ease;
}
.month-control:active { opacity: .72; }

/* 月度统计 */
.month-stats {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 8rpx;
  border-radius: var(--radius-md) var(--radius-lg) var(--radius-sm) var(--radius-lg);
  background: var(--grad-water);
  color: #FFF;
}
.month-stats view { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-number { color: var(--sun); font-family: 'DIN Alternate', sans-serif; font-size: 34rpx; font-weight: 700; }
.stat-caption { color: var(--on-dark-faint); font-size: 19rpx; }

/* 日历网格 */
.calendar-board {
  margin-top: 18rpx;
  padding: 16rpx 8rpx 10rpx;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
}
.weekday-row, .days-grid { display: flex; flex-wrap: wrap; }
.weekday-row text, .day-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 14.285%;
  box-sizing: border-box;
}
.weekday-row text { height: 54rpx; color: var(--muted); font-size: 20rpx; }
.day-cell { position: relative; height: 72rpx; color: var(--ink); font-size: 23rpx; }
.day-cell.selected text {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #FFF;
}
.day-cell.has-activity::after {
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--water);
  content: '';
}
.day-cell.selected.has-activity::after { background: var(--gold); }

/* 日期详情 */
.day-details {
  margin-top: 20rpx;
  padding: 20rpx;
  border-top: 2rpx solid var(--water);
  background: var(--paper);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}
.detail-heading {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}
.detail-heading text:last-child { color: var(--muted); font-size: 21rpx; font-weight: 400; }
.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.detail-item:last-child { border-bottom: none; }
.earned-points { color: var(--water-lo); font-weight: 700; }
.empty-inline { padding: 18rpx 0; color: var(--muted); font-size: 23rpx; }
