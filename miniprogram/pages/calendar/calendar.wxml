<!--pages/calendar/calendar.wxml-->
<view class="container">
  <scroll-view scroll-x class="child-bar">
    <view class="child-list">
      <view class="child-item {{item._id === selectedChild._id ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}">
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
  <view class="month-nav">
    <text class="nav-btn" bindtap="onPrevMonth">‹</text>
    <text class="month-label">{{year}}年{{month}}月</text>
    <text class="nav-btn" bindtap="onNextMonth">›</text>
  </view>
  <view class="month-stats" wx:if="{{monthStats}}">
    <view class="stat-item"><text class="stat-num">{{monthStats.totalEarned}}</text><text class="stat-label">本月获得</text></view>
    <view class="stat-item"><text class="stat-num">{{monthStats.totalSpent}}</text><text class="stat-label">本月兑换</text></view>
    <view class="stat-item"><text class="stat-num">{{monthStats.taskCount}}</text><text class="stat-label">完成任务</text></view>
  </view>
  <view class="calendar">
    <view class="weekday-row"><text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="{{index}}">{{item}}</text></view>
    <view class="days-grid">
      <view class="day-cell {{item.hasActivity ? 'active' : ''}} {{item.selected ? 'selected' : ''}}" wx:for="{{days}}" wx:key="index" bindtap="onDayTap" data-date="{{item.date}}">
        <text class="day-num" wx:if="{{!item.empty}}">{{item.day}}</text>
        <text class="activity-dot" wx:if="{{item.hasActivity && !item.empty}}">●</text>
      </view>
    </view>
  </view>
  <view class="day-details" wx:if="{{selectedDate && dayDetails}}">
    <text class="detail-title">{{selectedDate}} 详情</text>
    <view class="detail-section" wx:if="{{dayDetails.tasks.length > 0}}">
      <text class="section-title">完成任务</text>
      <view class="detail-item" wx:for="{{dayDetails.tasks}}" wx:key="_id">
        <text>{{item.taskName}}</text><text class="points">+{{item.actualPoints}}</text>
      </view>
    </view>
    <view class="detail-section" wx:if="{{dayDetails.rewards.length > 0}}">
      <text class="section-title">兑换奖励</text>
      <view class="detail-item" wx:for="{{dayDetails.rewards}}" wx:key="_id">
        <text>{{item.rewardName}}</text><text class="points spend">-{{item.pointsSpent}}</text>
      </view>
    </view>
    <text class="empty-tip" wx:if="{{dayDetails.tasks.length === 0 && dayDetails.rewards.length === 0}}">这一天没有记录</text>
  </view>
</view>