<view class="container calendar-page">
  <view class="page-intro"><text class="eyebrow">回看每一天的积累</text><text class="page-title">积分日历</text></view>
  <scroll-view scroll-x class="child-strip" wx:if="{{children.length > 1}}"><view class="child-strip-inner"><view class="child-pill {{item._id === selectedChild._id ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}"><text>{{item.name}}</text></view></view></scroll-view>
  <view class="month-heading"><view class="month-control" bindtap="onPrevMonth">‹</view><text>{{year}}年{{month}}月</text><view class="month-control" bindtap="onNextMonth">›</view></view>
  <view class="month-stats" wx:if="{{monthStats}}"><view><text class="stat-number">{{monthStats.totalEarned}}</text><text class="stat-caption">获得积分</text></view><view><text class="stat-number">{{monthStats.taskCount}}</text><text class="stat-caption">完成任务</text></view></view>
  <view class="calendar-board"><view class="weekday-row"><text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text></view><view class="days-grid"><view class="day-cell {{item.hasActivity ? 'has-activity' : ''}} {{selectedDate === item.date ? 'selected' : ''}}" wx:for="{{days}}" wx:key="index" bindtap="onDayTap" data-date="{{item.date}}"><text wx:if="{{!item.empty}}">{{item.day}}</text><view wx:if="{{item.hasActivity && !item.empty}}"></view></view></view></view>
  <view class="day-details" wx:if="{{selectedDate && dayDetails}}"><view class="detail-heading"><text>{{selectedDate}}</text><text>当日记录</text></view><view class="detail-item" wx:for="{{dayDetails.tasks}}" wx:key="_id"><text>{{item.taskName}}</text><text class="earned-points">+{{item.actualPoints}}</text></view><view class="empty-inline" wx:if="{{dayDetails.tasks.length === 0}}">这一天还没有积分变化</view></view>
  <view class="loading" wx:if="{{loading}}">正在读取当天记录…</view>
</view>
