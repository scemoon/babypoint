/* pages/index/index.wxss | 首页样式 v2.0 */

/* ==================== 顶部导航栏 ==================== */
.header-bar {
  background: var(--color-primary-gradient);
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 0 0 40rpx 40rpx;
  min-height: 120rpx;
}

.child-selector-left {
  display: flex;
  align-items: center;
}

.child-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.child-avatar .avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.child-avatar .avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.child-info {
  display: flex;
  flex-direction: column;
}

.child-info .child-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 4rpx;
}

.grade-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
  width: fit-content;
}

.selector-arrow {
  padding: 16rpx;
}

/* ==================== 积分卡片 ==================== */
.points-card {
  margin: 24rpx;
  padding: 32rpx;
  background: var(--color-surface);
  position: relative;
}

.points-main {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.points-left {
  margin-right: 24rpx;
}

.avatar-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFE4D6 0%, #FFD4C4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 139, 69, 0.2);
}

.avatar-main {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.avatar-img-main {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}

.points-center {
  flex: 1;
}

.available-points {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-primary);
  display: block;
  line-height: 1;
  margin-bottom: 8rpx;
}

.points-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.points-right {
  text-align: center;
}

.rank-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(145deg, #FFF9E6 0%, #FFF3CC 100%);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 217, 61, 0.25);
}

.rank-badge .rank-num {
  font-size: 24rpx;
  font-weight: 600;
  color: #B8860B;
  margin-top: 4rpx;
}

/* ==================== 积分统计 ==================== */
.points-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--color-border);
}

/* ==================== 快捷入口 ==================== */
.quick-actions {
  display: flex;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.action-card {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-md);
  transition: all var(--transition-fast);
}

.action-card:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-sm);
}

.action-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.calendar-icon {
  background: linear-gradient(145deg, #E8FAF8 0%, #D1F0EC 100%);
}

.history-icon {
  background: linear-gradient(145deg, #FFF0E8 0%, #FFE4D6 100%);
}

.ranking-icon {
  background: linear-gradient(145deg, #FFF9E6 0%, #FFF3CC 100%);
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

/* ==================== 区块卡片 ==================== */
.section-card {
  margin: 0 24rpx 24rpx;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.section-header {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-left: 12rpx;
}

/* ==================== 排行榜 ==================== */
.ranking-list {
  padding: 8rpx 0;
}

.ranking-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  transition: background var(--transition-fast);
}

.ranking-item:active {
  background: #F9FAFB;
}

.rank-left {
  display: flex;
  align-items: center;
}

.rank-medal {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: #F3F4F6;
}

.rank-medal.medal-1 {
  background: linear-gradient(145deg, #FFF9E6 0%, #FFE066 100%);
  box-shadow: 0 2rpx 12rpx rgba(255, 217, 61, 0.4);
}

.rank-medal.medal-2 {
  background: linear-gradient(145deg, #F5F5F5 0%, #E5E5E5 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.rank-medal.medal-3 {
  background: linear-gradient(145deg, #FFF5E6 0%, #FFE0C0 100%);
  box-shadow: 0 2rpx 8rpx rgba(255, 179, 71, 0.3);
}

.rank-number {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.rank-char {
  font-size: 26rpx;
  font-weight: 700;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.rank-right {
  display: flex;
  align-items: baseline;
}

.rank-points {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.rank-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-left: 4rpx;
}

/* ==================== 最新兑换 ==================== */
.recent-list {
  padding: 8rpx 0;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  transition: background var(--transition-fast);
}

.recent-item:active {
  background: #F9FAFB;
}

.recent-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #FFF0E8 0%, #FFE4D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.recent-info {
  flex: 1;
}

.recent-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.recent-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.recent-points {
  text-align: right;
}

.points-minus {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-error);
}

/* ==================== 选择器弹窗 ==================== */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.picker-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.picker-sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform var(--transition-normal);
}

.picker-mask.show .picker-sheet {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.picker-close {
  padding: 8rpx;
}

.picker-list {
  max-height: 50vh;
  overflow-y: auto;
  padding: 20rpx 32rpx 40rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  background: #F9FAFB;
  transition: all var(--transition-fast);
}

.picker-item.active {
  background: linear-gradient(145deg, #FFF5F0 0%, #FFE8E0 100%);
  border: 2rpx solid var(--color-primary);
}

.picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFE4D6 0%, #FFD4C4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.picker-avatar image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.picker-info {
  flex: 1;
}

.picker-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.picker-grade {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.picker-check {
  padding: 8rpx;
}
