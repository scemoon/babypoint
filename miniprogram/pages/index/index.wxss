/* index.wxss - 首页 */
.home-page { padding-top: 24rpx; padding-bottom: 160rpx; }

/* ========== 欢迎行 ========== */
.welcome-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 24rpx;
}
.welcome-copy { display: flex; flex-direction: column; gap: 6rpx; }
.eyebrow { color: var(--muted); font-size: 22rpx; font-weight: 500; }
.welcome-title, .page-title { color: var(--ink); font-size: 38rpx; font-weight: 750; letter-spacing: -0.5rpx; }

.child-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--paper);
  transition: all .12s ease;
}
.child-switch:active { transform: scale(.97); }

.no-child-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 36rpx;
  padding: 30rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm) var(--radius-md) var(--radius-sm) var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.no-child-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 20rpx;
  border-radius: var(--radius-md);
  background: var(--soft-water);
}
.no-child-title { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.no-child-copy { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.no-child-button { width: 100%; height: 88rpx; margin-top: 24rpx; border-radius: var(--radius-md); }

.switch-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--soft-lime);
  color: var(--ink);
  font-weight: 700;
}
.avatar-image { width: 100%; height: 100%; }
.switch-name {
  max-width: 100rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 23rpx;
  color: var(--ink);
}
.switch-mark { color: var(--hint); }

/* ========== 积分面板：明亮青碧渐变 ========== */
.score-panel {
  position: relative;
  padding: 28rpx;
  border-radius: var(--radius-md) var(--radius-lg) var(--radius-sm) var(--radius-lg);
  background: var(--grad-water);
  color: #FFF;
  overflow: hidden;
}
/* 活泼装饰：柔光圆（低对比，不干扰读数）*/
.score-panel::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
  pointer-events: none;
}
.score-panel::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--lime) 50%, transparent 100%);
}
.score-topline, .score-foot, .score-number-row { display: flex; align-items: center; }
/* 加载占位：骨架条与积分卡片同形，刷新时先占住位置，避免闪出错误卡片或布局跳动 */
.score-panel-skeleton { opacity: .8; }
.score-panel-skeleton .score-number-row { min-height: 123rpx; }
.skeleton-bar {
  width: 220rpx;
  height: 62rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, .22);
  animation: skeleton-pulse 1.1s ease-in-out infinite;
}
@keyframes skeleton-pulse {
  0%, 100% { opacity: .45; }
  50% { opacity: 1; }
}
.score-topline { justify-content: space-between; }
.score-caption { color: var(--on-dark-faint); font-size: 24rpx; }
.score-number-row { align-items: baseline; gap: 12rpx; margin: 4rpx 0 18rpx; }
.score-number {
  color: var(--sun);
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  font-size: 112rpx;
  line-height: 1.1;
  font-weight: 700;
}
.score-unit { color: var(--on-dark-faint); font-size: 24rpx; }
.score-divider { height: 1rpx; background: var(--line-strong); }
.score-foot { display: flex; flex-direction: column; gap: 18rpx; padding-top: 18rpx; }
.score-stats { display: flex; align-items: baseline; gap: 34rpx; }
.score-stat { display: flex; align-items: baseline; gap: 8rpx; }
.score-small { color: #FFF; font-size: 27rpx; font-weight: 700; }
.score-small-label { color: var(--on-dark-faint); font-size: 21rpx; }
.score-tools { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.score-shortcut { display: flex; align-items: center; gap: 7rpx; color: var(--on-dark-faint); font-size: 21rpx; }
.score-shortcut:active { opacity: .72; }

/* ========== 首页快捷操作 ========== */
.home-actions { display: flex; align-items: stretch; gap: 14rpx; margin: 20rpx 0 32rpx; }
.primary-action, .secondary-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 128rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  transition: transform .12s ease, opacity .12s ease;
}
.primary-action:active, .secondary-action:active { transform: scale(.985); opacity: .92; }
.primary-action { flex: 1.08; background: var(--gold); color: var(--ink); box-shadow: 0 8rpx 22rpx rgba(214,232,90,.25); }
.secondary-action { flex: .92; background: var(--grad-water); color: #FFF; }
.action-copy { display: flex; flex-direction: column; gap: 6rpx; }
/* 注：这里刻意不用 opacity 弱化文字。面板底色已压到「白字仅 4.78:1」的明度，
   再乘一层不透明度会直接掉到 3.26:1（不可读）。层级改由字号 + 各自的浅色令牌体现。*/
.action-kicker { font-size: 21rpx; }
.primary-action .action-kicker { color: rgba(20,52,61,.72); }
.secondary-action .action-kicker { color: var(--on-dark-faint); }
.action-title { font-size: 29rpx; font-weight: 700; }
.action-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
}

/* ========== 列表标题 ========== */
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 2rpx 14rpx;
}
.section-copy { display: flex; flex-direction: column; gap: 2rpx; }
.section-title { font-size: 29rpx; font-weight: 700; color: var(--ink); }
.section-note { color: var(--hint); font-size: 21rpx; }

/* ========== 排行榜 ========== */
.rank-list, .redemption-list { overflow: hidden; border-top: 1rpx solid var(--line); }
.rank-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 96rpx;
  padding: 6rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.rank-current {
  padding: 6rpx 12rpx;
  background: var(--soft-water);
  margin: 0 -12rpx;
  border-radius: var(--radius-sm);
  border-bottom-color: transparent;
}
.rank-avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  overflow: hidden;
  border-radius: 50%;
  background: var(--soft-lime);
  color: var(--ink);
  font-weight: 700;
}
.rank-avatar image { width: 100%; height: 100%; }
.rank-info { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 2rpx; }
.rank-name { color: var(--ink); font-size: 26rpx; font-weight: 700; }
.rank-sub { color: var(--muted); font-size: 20rpx; }
.rank-right { display: flex; flex-direction: column; align-items: flex-end; }
.rank-index { color: var(--water-lo); font-family: 'DIN Alternate', sans-serif; font-size: 25rpx; font-weight: 700; }
.rank-score { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.rank-unit { color: var(--hint); font-size: 18rpx; font-weight: 400; }
.ranking-more {
  padding: 20rpx 0 6rpx;
  color: var(--water-lo);
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
}
.empty-inline { padding: 22rpx 0; color: var(--muted); font-size: 24rpx; }

/* ========== 兑换列表：右侧展示兑换所需积分 ========== */
.redemption-heading { margin-top: 32rpx; }
.text-link {
  padding: 10rpx 0 10rpx 16rpx;
  color: var(--water-lo);
  font-size: 23rpx;
  font-weight: 650;
}
.text-link:active { opacity: .7; }
.redemption-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 96rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.redemption-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm) var(--radius-md) var(--radius-sm) var(--radius-sm);
  background: var(--soft-coral);
}
.redemption-info { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 4rpx; }
.redemption-name {
  font-size: 26rpx;
  font-weight: 650;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.redemption-date { color: var(--muted); font-size: 20rpx; }
.redemption-cost {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--soft-coral);
}
.redemption-cost .cost-value {
  color: var(--coral-text);
  font-family: 'DIN Alternate', sans-serif;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.1;
}
.redemption-cost .cost-label {
  color: var(--coral-warm);
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* ========== 孩子选择器 ========== */
.picker-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(25,54,66,.48);
}
.picker-sheet {
  width: 100%;
  padding: 30rpx 30rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--mist);
}
.picker-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.picker-close { color: var(--water-lo); font-size: 24rpx; font-weight: 500; }
.picker-option {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}
.option-grade { flex: 1; color: var(--muted); font-size: 23rpx; }
