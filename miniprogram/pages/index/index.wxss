/* pages/index/index.wxss | 首页样式 v4.0 */
/* Friendly Flat Design - 温暖友好型扁平化设计 */

/* ==================== 顶部导航栏 ==================== */
.nav-bar {
  background: var(--color-primary);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.nav-left {
  display: flex;
  align-items: center;
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.nav-right {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx 8rpx 8rpx;
  border-radius: var(--radius-full);
}

.nav-child-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.nav-child-avatar text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.nav-child-avatar image {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
}

.nav-child-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  margin-left: 12rpx;
}

.nav-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

/* ==================== 主要内容区 ==================== */
.main-content {
  padding: 24rpx;
}

/* ==================== 核心积分卡片 ==================== */
.points-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
}

/* 孩子信息 */
.card-child-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.child-avatar-wrap {
  margin-right: 20rpx;
}

.child-avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.child-avatar-circle text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.child-avatar-circle image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.child-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.child-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.child-grade {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.rank-badge {
  display: flex;
  align-items: center;
  background: rgba(245, 158, 11, 0.12);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
}

.rank-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.rank-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-accent);
}

/* 积分展示 */
.card-points-main {
  text-align: center;
  padding: 32rpx 0;
  border-top: 1rpx solid var(--color-border);
  border-bottom: 1rpx solid var(--color-border);
  margin: 24rpx 0;
}

.points-display {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.points-value {
  font-size: 96rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
  margin-bottom: 8rpx;
}

.points-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* 积分统计 */
.card-points-stats {
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 6rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--color-border);
}

/* ==================== 快捷入口 ==================== */
.quick-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-item {
  flex: 1;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.action-item:active {
  background: var(--color-surface-hover);
  transform: scale(0.97);
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.bg-calendar {
  background: rgba(59, 130, 246, 0.1);
}

.bg-history {
  background: rgba(249, 115, 22, 0.1);
}

.bg-ranking {
  background: rgba(245, 158, 11, 0.1);
}

.action-emoji {
  font-size: 40rpx;
}

.action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

/* ==================== 区块卡片 ==================== */
.section-card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

.more-arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
}

/* ==================== 排行榜 ==================== */
.ranking-list {
  padding: 8rpx 0;
}

.ranking-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  transition: background var(--transition-fast);
}

.ranking-item:active {
  background: var(--color-surface-hover);
}

.rank-left {
  display: flex;
  align-items: center;
}

.rank-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-hover);
  margin-right: 16rpx;
  font-size: 28rpx;
}

.rank-number.rank-top {
  background: rgba(245, 158, 11, 0.1);
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.rank-right {
  display: flex;
  align-items: baseline;
}

.rank-points {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.rank-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-left: 6rpx;
}

/* ==================== 最新兑换 ==================== */
.recent-list {
  padding: 8rpx 0;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  transition: background var(--transition-fast);
}

.recent-item:active {
  background: var(--color-surface-hover);
}

.recent-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-xs);
  background: rgba(249, 115, 22, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.recent-icon text {
  font-size: 32rpx;
}

.recent-info {
  flex: 1;
}

.recent-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.recent-time {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.recent-points {
  text-align: right;
}

.points-minus {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-secondary);
}

/* ==================== 选择器弹窗 ==================== */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.picker-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.picker-sheet {
  width: 100%;
  background: var(--color-surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  max-height: 70vh;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform var(--transition-normal);
}

.picker-mask.show .picker-sheet {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.picker-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--color-text-tertiary);
}

.picker-list {
  max-height: 60vh;
  overflow-y: auto;
  padding: 24rpx 32rpx 40rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  background: var(--color-surface-hover);
  transition: all var(--transition-fast);
}

.picker-item.active {
  background: rgba(59, 130, 246, 0.1);
  border: 1rpx solid var(--color-primary);
}

.picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.picker-avatar image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.picker-info {
  flex: 1;
}

.picker-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.picker-grade {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.picker-check {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 700;
}
