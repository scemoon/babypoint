.child-page { padding-top: 24rpx; padding-bottom: 150rpx; }
.child-entry { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; margin-bottom: 14rpx; padding: 18rpx; border: 1rpx solid var(--line); border-left: 6rpx solid transparent; border-radius: 14rpx 20rpx 20rpx 14rpx; background: var(--paper); }
.child-entry.current { border-left-color: var(--water-lo); }
.child-avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--gold); color: var(--ink); font-size: 30rpx; font-weight: 700; }
.child-info { display: flex; flex: 1; flex-direction: column; gap: 4rpx; }
.child-name { color: var(--ink); font-size: 28rpx; font-weight: 700; }
.child-grade { color: var(--muted); font-size: 21rpx; }
.child-points { display: flex; flex-direction: column; align-items: flex-end; color: var(--muted); font-size: 19rpx; }
.child-points text:first-child { color: var(--ink); font-family: 'DIN Alternate', sans-serif; font-size: 30rpx; font-weight: 700; }
.current-chip { padding: 5rpx 10rpx; border-radius: 7rpx; background: var(--soft-water); color: var(--water-lo); font-size: 19rpx; }
.child-actions { display: flex; width: 100%; gap: 20rpx; padding-top: 12rpx; border-top: 1rpx solid var(--line); color: var(--water-lo); font-size: 22rpx; }
.child-actions .delete { color: var(--danger); }
.add-child-button, .save-button { border-radius: 18rpx; }
.add-child-button { position: fixed; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 5; height: 96rpx; }
.empty-state { align-items: center; padding: 70rpx 20rpx; text-align: center; }
.modal-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(15,36,44,.5); }
.modal-content { width: 100%; padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: var(--mist); box-sizing: border-box; }
/* 键盘弹起：弹层高度收敛到「键盘之上」的可见区域（mask 已按键盘高度留出 padding），
   内容超出时弹层内部滚动，不会顶出屏幕外 */
.modal-content.kb-open { max-height: 100%; overflow-y: auto; }
.modal-heading { display: flex; justify-content: space-between; margin-bottom: 22rpx; color: var(--ink); font-size: 30rpx; font-weight: 700; }
.modal-heading text:last-child { color: var(--water-lo); font-size: 22rpx; font-weight: 500; }
.form-item { margin-bottom: 18rpx; }
.label { display: block; margin-bottom: 8rpx; color: var(--muted); font-size: 22rpx; }
.input, .picker-value { width: 100%; min-height: 82rpx; padding: 20rpx; font-size: 25rpx; }
.picker-value { display: flex; justify-content: space-between; align-items: center; }
.gender-group { display: flex; justify-content: space-between; padding: 10rpx; border-radius: 12rpx; background: var(--paper); }
.gender-group label { display: flex; align-items: center; gap: 4rpx; color: var(--ink); font-size: 22rpx; }
.save-button { width: 100%; height: 88rpx; margin-top: 10rpx; }
/* 弹层里的保存按钮必须留在弹层内部：app.wxss 给 .save-button 的定位是 position: fixed
   （给页面级底部 CTA 用的）。fixed 元素相对视口定位、不随弹层移动 —— 键盘弹起时弹层被
   顶到键盘之上，按钮却留在原地被键盘吞掉；不弹键盘时它也会压在性别选择行上。 */
.modal-content .save-button { position: static; }
