<!--pages/reward/reward.wxml | 奖励页 v4.0-->
<view class="container">
  <!-- 顶部孩子选择器 + 积分显示 -->
  <view class="child-bar">
    <scroll-view scroll-x class="child-selector">
      <view class="child-list">
        <view 
          class="child-tab {{item._id === selectedChild._id ? 'active' : ''}}" 
          wx:for="{{children}}" 
          wx:key="_id" 
          bindtap="onSelectChild" 
          data-id="{{item._id}}"
        >
          <view class="tab-avatar">
            <text wx:if="{{!item.avatar}}">{{item.name[0]}}</text>
            <image wx:else src="{{item.avatar}}"/>
          </view>
          <text class="tab-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    
    <!-- 积分显示条 -->
    <view class="points-strip" wx:if="{{selectedChild}}">
      <view class="points-info">
        <text class="points-star">⭐</text>
        <text class="points-num">{{(selectedChild.totalPoints || 0) - (selectedChild.redeemedPoints || 0)}}</text>
      </view>
      <text class="points-label">可用积分</text>
    </view>
  </view>

  <!-- 分类标签栏 -->
  <scroll-view scroll-x class="category-bar">
    <view class="category-list">
      <view 
        class="category-item {{currentCategory === '' ? 'active' : ''}}" 
        bindtap="onCategoryChange" 
        data-index="-1"
      >
        <text>全部</text>
      </view>
      <view 
        class="category-item {{currentCategory === item.key ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="key" 
        bindtap="onCategoryChange" 
        data-index="{{index}}"
      >
        <text class="cat-emoji">{{item.emoji || '🎁'}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 奖励网格 -->
  <scroll-view scroll-y class="reward-grid" wx:if="{{!loading}}">
    <view class="reward-card" wx:for="{{rewards}}" wx:key="_id" bindtap="onRewardTap" data-reward="{{item}}">
      <view class="reward-icon-wrap">
        <text class="reward-emoji">{{item.emoji || '🎁'}}</text>
      </view>
      <text class="reward-name">{{item.name}}</text>
      <text class="reward-desc">{{item.description}}</text>
      <view class="reward-footer">
        <text class="reward-points">⭐ {{item.points}}</text>
        <text class="reward-unit">积分</text>
      </view>
      <!-- 可兑换标识 -->
      <view class="redeemable-badge" wx:if="{{selectedChild && (selectedChild.totalPoints - selectedChild.redeemedPoints) >= item.points}}">
        <text>可兑换</text>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{rewards.length === 0}}">
      <text class="empty-icon">🎁</text>
      <text class="empty-text">暂无奖励</text>
      <text class="empty-hint">点击下方按钮添加新奖励</text>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="onAddReward">
    <text class="fab-icon">+</text>
  </view>
</view>
