<view class="container reward-page">
  <view class="balance-panel" wx:if="{{selectedChild}}">
    <view class="balance-copy"><text class="eyebrow">{{selectedChild.name}} 的奖励柜</text><text class="balance-label">现在可兑换</text><view><text class="balance-number">{{(selectedChild.totalPoints || 0) - (selectedChild.redeemedPoints || 0)}}</text><text class="balance-unit">积分</text></view></view>
    <view class="balance-mark"><icon name="gift" size="56" color="#14343D"/></view>
  </view>

  <scroll-view scroll-x class="child-strip" wx:if="{{children.length > 1}}">
    <view class="child-strip-inner">
      <view class="child-pill {{item._id === selectedChild._id ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}">
        <view class="tiny-avatar"><text wx:if="{{!item.avatar}}">{{item.name[0]}}</text><image wx:else src="{{item.avatar}}" mode="aspectFill"/></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 搜索框 + 悬浮的添加按钮：同行右侧以 + icon 出现 -->
  <view class="search-bar-row">
    <view class="search-bar">
      <text class="search-icon">⌕</text>
      <input class="search-input" placeholder="搜索奖励名称或描述" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" cursor-spacing="24"/>
      <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</text>
    </view>
    <view class="search-add" hover-class="search-add--active" bindtap="onAddReward">
      <text class="search-add-plus">+</text>
    </view>
  </view>

  <!-- 分类筛选（全展示网格） -->
  <view class="filter-card">
    <view class="filter-card-head">
      <text class="filter-card-title">奖励分类</text>
    </view>
    <view class="category-grid">
      <view class="category-item {{currentCategory === '' ? 'active' : ''}}" bindtap="onCategoryChange" data-key="">
        <text class="category-icon">★</text>
        <text class="category-name">全部</text>
      </view>
      <view wx:for="{{categories}}" wx:key="key" class="category-item {{currentCategory === item.key ? 'active' : ''}}" bindtap="onCategoryChange" data-key="{{item.key}}">
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="list-heading">
    <text>奖励清单</text>
    <text class="hint" wx:if="{{keyword}}">搜索 "{{keyword}}"</text>
    <text class="hint" wx:else>选中一项查看兑换详情</text>
  </view>

  <view class="reward-list" wx:if="{{!loading && filteredRewards.length}}">
    <view class="reward-row" wx:for="{{filteredRewards}}" wx:key="_id" bindtap="onRewardTap" data-reward="{{item}}">
      <view class="reward-symbol"><icon name="gift" size="42" color="#14343D"/></view>
      <view class="reward-main">
        <text class="reward-name">{{item.name}}</text>
        <text class="reward-description">{{item.description}}</text>
        <view class="afford-label" wx:if="{{selectedChild && (selectedChild.totalPoints - selectedChild.redeemedPoints) >= item.points}}">积分足够</view>
        <view class="short-label" wx:else>还差 {{item.points - ((selectedChild.totalPoints || 0) - (selectedChild.redeemedPoints || 0))}} 分</view>
      </view>
      <view class="reward-price"><text>{{item.points}}</text><text>积分</text></view>
      <text class="task-chevron">›</text>
    </view>
  </view>

  <view class="empty-state center" wx:if="{{!loading && filteredRewards.length === 0}}">
    <icon name="gift" size="58" color="#12807A"/>
    <text class="empty-text" wx:if="{{keyword}}">没有匹配的奖励</text>
    <text class="empty-text" wx:else>奖励清单还是空的</text>
    <text class="empty-hint" wx:if="{{keyword}}">换个关键词或分类试试</text>
    <text class="empty-hint" wx:else>和孩子一起定一个期待兑换的小奖励。</text>
    <button class="empty-button" bindtap="onAddReward" wx:if="{{!keyword}}">添加奖励</button>
  </view>

  <view class="loading" wx:if="{{loading}}">正在准备奖励…</view>

  <!-- 键盘占位：撑出可滚动余量，把搜索框等输入框推到键盘之上（收起时高度为 0） -->
  <view class="keyboard-spacer" style="height: {{keyboardHeight}}px"></view>
</view>
