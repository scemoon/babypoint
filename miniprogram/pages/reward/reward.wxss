/* pages/reward/reward.wxss | 奖励列表页样式 v4.0 */
/* Friendly Flat Design */

/* ==================== 顶部栏 ==================== */
.child-bar {
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
}

/* ==================== 孩子选择器 ==================== */
.child-selector {
  white-space: nowrap;
}

.child-list {
  padding: 0 20rpx;
  display: flex;
}

.child-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: var(--color-surface-hover);
  border-radius: var(--radius-full);
  transition: all var(--transition-fast);
}

.child-tab.active {
  background: var(--color-primary);
}

.tab-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  overflow: hidden;
}

.tab-avatar image {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.child-tab.active .tab-avatar {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.tab-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.child-tab.active .tab-name {
  color: #FFFFFF;
}

/* ==================== 积分显示条 ==================== */
.points-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx;
  padding: 20rpx 28rpx;
  background: rgba(245, 158, 11, 0.1);
  border-radius: var(--radius-md);
}

.points-info {
  display: flex;
  align-items: center;
}

.points-star {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.points-info .points-num {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-accent);
}

.points-strip .points-label {
  font-size: 26rpx;
  color: var(--color-accent);
}

/* ==================== 分类标签栏 ==================== */
.category-bar {
  background: var(--color-surface);
  padding: 16rpx 20rpx 20rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--color-border);
}

.category-list {
  display: flex;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  background: var(--color-surface-hover);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.category-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.cat-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* ==================== 奖励网格 ==================== */
.reward-grid {
  height: calc(100vh - 420rpx);
  padding: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  box-sizing: border-box;
}

.reward-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 32rpx 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all var(--transition-fast);
}

.reward-card:active {
  background: var(--color-surface-hover);
  transform: scale(0.98);
}

.reward-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  background: rgba(249, 115, 22, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.reward-emoji {
  font-size: 60rpx;
}

.reward-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.reward-desc {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.reward-footer {
  display: flex;
  align-items: center;
  justify-content: center;
}

.reward-points {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent);
}

.reward-unit {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-left: 6rpx;
}

/* 可兑换标识 */
.redeemable-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: var(--color-success);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

/* ==================== 空状态 ==================== */
.empty-state {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.empty-state .empty-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.4);
  z-index: 100;
  transition: all var(--transition-fast);
}

.fab:active {
  transform: scale(0.92);
  background: var(--color-primary-dark);
}

.fab-icon {
  font-size: 64rpx;
  font-weight: 300;
  color: #FFFFFF;
  line-height: 1;
}
