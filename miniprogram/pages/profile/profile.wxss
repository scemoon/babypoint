/* pages/profile/profile.wxss | 个人中心页样式 v4.0 */
/* Friendly Flat Design */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  background: var(--color-background);
  padding: 24rpx;
}

/* ==================== 孩子卡片 ==================== */
.child-card {
  background: var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

.child-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-wrap {
  margin-bottom: 20rpx;
}

.child-avatar {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.child-info {
  text-align: center;
}

.child-name {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}

.child-grade {
  font-size: 26rpx;
  opacity: 0.85;
}

/* ==================== 统计区域 ==================== */
.child-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 28rpx 0;
  margin: 24rpx 0;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-md);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  display: block;
  line-height: 1;
  margin-bottom: 8rpx;
  color: #FFFFFF;
}

.stat-num.available {
  color: var(--color-accent);
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* ==================== 管理按钮 ==================== */
.manage-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: var(--radius-sm);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}

.manage-btn::after {
  border: none;
}

.manage-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.btn-icon {
  font-size: 32rpx;
}

/* ==================== 菜单卡片 ==================== */
.menu-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  transition: background var(--transition-fast);
}

.menu-item:active {
  background: var(--color-surface-hover);
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-xs);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.menu-emoji {
  font-size: 36rpx;
}

.history-icon {
  background: rgba(249, 115, 22, 0.1);
}

.reward-icon {
  background: rgba(16, 185, 129, 0.1);
}

.calendar-icon {
  background: rgba(245, 158, 11, 0.1);
}

.menu-text {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-primary);
}

.menu-arrow {
  padding: 8rpx;
}

.arrow-icon {
  font-size: 36rpx;
  color: var(--color-text-tertiary);
}

.menu-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 0 28rpx;
}

/* ==================== 应用信息 ==================== */
.app-info {
  text-align: center;
  padding: 32rpx;
}

.app-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-tertiary);
  display: block;
  margin-bottom: 4rpx;
}

.app-version {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}
