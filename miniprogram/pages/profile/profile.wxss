/* profile.wxss - 我的页 */
.profile-page { padding-top: 24rpx; }

.parent-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background: var(--soft-water);
}
.parent-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  overflow: hidden;
  border-radius: 50%;
  background: var(--water);
  color: #FFF;
  font-size: 30rpx;
  font-weight: 700;
}
.parent-avatar image { width: 100%; height: 100%; }
.parent-copy { display: flex; flex-direction: column; gap: 4rpx; }
.parent-name { color: var(--ink); font-size: 27rpx; font-weight: 700; }
.parent-caption { color: var(--muted); font-size: 20rpx; }
.eyebrow { color: var(--muted); font-size: 22rpx; font-weight: 500; }

/* ========== 个人资料卡片 ==========
   与首页 .score-panel 保持一致：同一套渐变、同样的装饰（柔光圆 + 底部嫩黄绿高光线）、
   同一套文字令牌（大数字 --sun / 标签 --on-dark-faint），字号与字体栈也对齐，
   避免两页的积分卡片看起来像两个产品。*/
.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border-radius: var(--radius-md) var(--radius-lg) var(--radius-sm) var(--radius-lg);
  background: var(--grad-water);
  color: #FFF;
}
.profile-hero::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -40rpx;
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.12);
  pointer-events: none;
}
.profile-hero::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent 0%, var(--lime) 50%, transparent 100%);
}
.profile-person { display: flex; align-items: center; gap: 14rpx; }
.profile-avatar, .person-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: var(--gold);
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}
.profile-avatar { width: 72rpx; height: 72rpx; }
.profile-avatar image { width: 100%; height: 100%; }
.profile-person > view:last-child { display: flex; flex-direction: column; gap: 3rpx; }
.profile-name { font-size: 30rpx; font-weight: 700; }
.profile-grade { color: var(--on-dark-faint); font-size: 24rpx; }
.profile-total {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 18rpx;
  color: var(--on-dark-faint);
  font-size: 24rpx;
}
.total-number {
  color: var(--sun);
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  font-size: 112rpx;
  line-height: 1.1;
  font-weight: 700;
}
/* 分割线：等价于首页的 .score-divider，这里用 border-top 实现，避免多一个空元素 */
.profile-balance {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-strong);
  color: var(--on-dark-faint);
  font-size: 21rpx;
}
.profile-balance text:last-child { color: #FFF; font-weight: 700; }

/* ========== 设置列表 ========== */
.settings-label { margin: 30rpx 0 12rpx; color: var(--muted); font-size: 22rpx; }
.settings-list { border-top: 1rpx solid var(--line); }
.settings-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--line);
  transition: opacity .12s ease;
}
.settings-row:active { opacity: .66; }
.settings-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: var(--radius-sm);
}
.settings-icon.cyan { background: var(--soft-water); }
.settings-icon.lime { background: var(--soft-lime); }
.settings-icon.coral { background: var(--soft-coral); }
.settings-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
}
.settings-copy text:last-child { color: var(--muted); font-size: 20rpx; font-weight: 400; }
.settings-arrow { color: var(--hint); font-size: 36rpx; }

/* ========== 页脚 ========== */
.profile-foot {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 34rpx;
  color: var(--hint);
  font-size: 20rpx;
}

/* ========== 联系方式弹层 ========== */
.contact-mask {
  position: fixed;
  z-index: 30;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(25,54,66,.55);
}
.contact-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 32rpx 26rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--paper);
  box-sizing: border-box;
}
.contact-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 750;
  text-align: center;
}
.contact-hint {
  margin: 8rpx 0 22rpx;
  color: var(--muted);
  font-size: 21rpx;
  text-align: center;
}
.contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}
.contact-item > view { display: flex; flex-direction: column; gap: 5rpx; }
.contact-label { color: var(--muted); font-size: 20rpx; }
.contact-value { color: var(--ink); font-size: 25rpx; font-weight: 650; }
.contact-copy {
  padding: 10rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--soft-water);
  color: var(--water-lo);
  font-size: 21rpx;
}
.contact-close {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: var(--radius-sm);
  background: var(--panel);
  color: #FFF;
  text-align: center;
  font-size: 23rpx;
  font-weight: 650;
}
