<!-- 加载中：与真实内容同尺寸的骨架，不出现白屏 -->
<view class="container redeem-page" wx:if="{{!reward && !failed}}">
  <view class="skeleton-coupon">
    <view class="sk-icon"></view>
    <view class="sk-line sk-w60"></view>
    <view class="sk-line sk-w40"></view>
    <view class="sk-ledger">
      <view class="sk-cell"></view>
      <view class="sk-cell"></view>
      <view class="sk-cell sk-cell-result"></view>
    </view>
  </view>
</view>

<!-- 加载失败：给出说明与重试入口，而不是一直空白 -->
<view class="container redeem-page" wx:if="{{failed}}">
  <view class="load-failed">
    <icon name="info" size="48" color="#14343D"/>
    <text class="failed-title">没能读取到奖励信息</text>
    <text class="failed-copy">检查网络后重试一次就好。</text>
    <button class="failed-button" bindtap="onRetry">重新加载</button>
  </view>
</view>

<view class="container redeem-page" wx:if="{{reward && child}}">
  <!-- 兑换券（竖版票）：上半是奖励身份，撕口以下是三联账目 —— 现在可用 / 花费 / 兑换后 -->
  <view class="coupon {{enough ? '' : 'short'}}">
    <view class="coupon-head">
      <view class="coupon-icon"><icon name="gift" size="52" color="#14343D"/></view>
      <text class="coupon-title">{{reward.name}}</text>
      <text class="coupon-desc" wx:if="{{reward.description}}">{{reward.description}}</text>
    </view>

    <view class="coupon-perf">
      <view class="perf-notch left"></view>
      <view class="perf-notch right"></view>
    </view>

    <view class="ledger">
      <view class="ledger-cell">
        <view class="ledger-who">
          <view class="ledger-avatar"><text wx:if="{{!child.avatar}}">{{child.name[0]}}</text><image wx:else src="{{child.avatar}}" mode="aspectFill"/></view>
          <text class="ledger-name">{{child.name}}</text>
        </view>
        <text class="ledger-label">现在可用</text>
        <text class="ledger-value">{{child.availablePoints}}</text>
      </view>
      <view class="ledger-cell">
        <text class="ledger-head">花费</text>
        <text class="ledger-label">积分</text>
        <text class="ledger-value coral">{{reward.points}}</text>
      </view>
      <view class="ledger-cell result {{enough ? '' : 'short'}}">
        <text class="ledger-head">{{enough ? '兑换后' : '还差'}}</text>
        <text class="ledger-label">{{enough ? '剩余' : '积分'}}</text>
        <text class="ledger-value">{{enough ? afterPoints : shortBy}}</text>
      </view>
    </view>
  </view>

  <view class="redeem-note"><icon name="info" size="32" color="#2A808A"/><text>确认后会立即记录兑换，积分余额随之更新。</text></view>

  <!-- 主操作：页面私有类名（避开 app.wxss 里 .redeem-button 的 fixed 规则）+ 动画结束后才渲染，
       与完成任务页同一套处理，切换过程中不会先出现 / 遮挡页面 -->
  <button class="redeem-cta {{enough ? '' : 'disabled'}}" wx:if="{{ctaVisible}}" bindtap="onRedeem" loading="{{loading}}" disabled="{{!enough}}">{{enough ? '确认兑换' : '积分还不够'}}</button>
</view>
