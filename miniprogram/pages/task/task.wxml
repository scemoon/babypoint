<!--pages/task/task.wxml-->
<view class="container">
  <!-- 孩子选择标签栏 -->
  <scroll-view scroll-x class="child-selector">
    <view class="child-list">
      <view 
        class="child-tab {{item._id === selectedChild._id ? 'active' : ''}}" 
        wx:for="{{children}}" 
        wx:key="_id" 
        bindtap="onSelectChild" 
        data-id="{{item._id}}"
      >
        <view class="tab-avatar">
          <text wx:if="{{!item.avatar}}">{{item.name[0]}}</text>
          <image wx:else src="{{item.avatar}}"/>
        </view>
        <text class="tab-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 分类标签栏 -->
  <scroll-view scroll-x class="category-bar">
    <view class="category-list">
      <view 
        class="category-item {{currentCategory === '' ? 'active' : ''}}" 
        bindtap="onCategoryChange" 
        data-index="-1"
      >
        <text>全部</text>
      </view>
      <view 
        class="category-item {{currentCategory === item.key ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="key" 
        bindtap="onCategoryChange" 
        data-index="{{index}}"
        style="--cat-color: {{item.color}}"
      >
        <view class="cat-icon-wrap">
          <icon name="{{item.iconType || 'list'}}" size="32" color="{{item.color || '#666'}}"/>
        </view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 任务列表 -->
  <scroll-view scroll-y class="task-list" wx:if="{{!loading}}">
    <view class="task-card" wx:for="{{tasks}}" wx:key="_id" bindtap="onTaskTap" data-task="{{item}}">
      <view class="task-icon-wrap" style="background: linear-gradient(145deg, {{item.iconBg || '#FFF0E8'}} 0%, {{item.iconBgEnd || '#FFE4D6'}} 100%);">
        <icon name="{{item.iconType || 'star'}}" size="48" color="{{item.iconColor || '#FF8B45'}}"/>
      </view>
      <view class="task-content">
        <text class="task-name">{{item.name}}</text>
        <text class="task-desc">{{item.description}}</text>
        <view class="task-meta">
          <view class="tag tag-primary">{{item.categoryName || '日常'}}</view>
        </view>
      </view>
      <view class="task-points">
        <text class="points-value">+{{item.basePoints}}</text>
        <text class="points-label">积分</text>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{tasks.length === 0}}">
      <icon name="list" size="120" color="#E5E7EB"/>
      <text class="empty-text">暂无任务</text>
      <text class="empty-hint">点击下方按钮添加新任务</text>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 浮动添加按钮 -->
  <view class="fab" bindtap="onAddTask">
    <icon name="plus" size="56" color="#FFFFFF"/>
  </view>
</view>
