<view class="container task-page">
  <!-- 页面标题：扁平页头，不用渐变面板 -->
  <view class="page-intro page-intro-flat">
    <text class="eyebrow">🌸 小红花 · 五育成长</text>

  </view>

  <!-- 孩子切换器 -->
  <scroll-view scroll-x class="child-strip" wx:if="{{children.length > 1}}">
    <view class="child-strip-inner">
      <view class="child-pill {{item._id === selectedChildId ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}">
        <view class="tiny-avatar"><text wx:if="{{!item.avatar}}">{{item.name[0]}}</text><image wx:else src="{{item.avatar}}" mode="aspectFill"/></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 育域：横向滚动 pill -->
  <view class="filter-card">
    <view class="filter-card-head">
      <text class="filter-card-title">五育领域</text>
      <text class="filter-card-hint">选择领域以筛选</text>
    </view>
    <scroll-view scroll-x class="domain-scroll" enhanced show-scrollbar="{{false}}">
      <view class="domain-pills">
        <view class="domain-pill tab-all {{currentDomain === '' ? 'active' : ''}}" bindtap="onDomainChange" data-domain="">
          <text>🌈</text><text>全部</text>
        </view>
        <view wx:for="{{domains}}" wx:key="key" wx:if="{{item.key}}" class="domain-pill {{currentDomain === item.key ? 'active' : ''}}" bindtap="onDomainChange" data-domain="{{item.key}}">
          <text>{{item.icon}}</text><text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 分类：紧凑网格（4列），放在状态上方 -->
  <view class="filter-card">
    <view class="filter-card-head">
      <text class="filter-card-title">任务分类</text>
      <text class="filter-card-hint">{{filteredCategories.length}} 项可选</text>
    </view>
    <view class="category-grid">
      <view class="category-tile {{currentCategory === '' ? 'active' : ''}}" bindtap="onCategoryChange" data-category="">
        <view class="category-tile-icon"><text>★</text></view>
        <text class="category-tile-name">全部</text>
      </view>
      <view wx:for="{{filteredCategories}}" wx:key="key" wx:if="{{item.key}}" class="category-tile {{currentCategory === item.key ? 'active' : ''}}" bindtap="onCategoryChange" data-category="{{item.key}}">
        <view class="category-tile-icon"><text>{{item.icon}}</text></view>
        <text class="category-tile-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 进度分段控件：待开始 / 进行中 / 已完成 / 已逾期 -->
  <scroll-view scroll-x class="status-scroll" enhanced show-scrollbar="{{false}}">
    <view class="status-segment">
      <view wx:for="{{statusTabs}}" wx:key="key" class="status-segment-item {{item.key === 'overdue' ? 'overdue' : ''}} {{currentStatus === item.key ? 'active' : ''}}" data-status="{{item.key}}" bindtap="onStatusChange">
        <text>{{item.name}}</text>
        <text class="status-count">{{item.count}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 列表标题 -->
  <view class="list-heading">
    <text>{{displayTasks.length}} 个周期 · {{currentStatusLabel}}</text>
    <text class="hint" wx:if="{{currentStatus === 'overdue'}}">⚠️ 逾期周期自动作废</text>
    <text class="hint" wx:elif="{{currentStatus === 'pending'}}">⏳ 尚未开始，可提前完成</text>
  </view>

  <!-- 任务列表：每个周期一行 -->
  <view class="task-list" wx:if="{{!loading && displayTasks.length}}">
    <view class="task-row {{item.status === 'completed' ? 'completed' : ''}} {{item.status === 'overdue' ? 'overdue' : ''}} {{item.status === 'pending' ? 'pending' : ''}}" wx:for="{{displayTasks}}" wx:key="_id" bindtap="onTaskTap" data-task="{{item}}">
      <!-- 左侧 emoji 图标：与发布页任务模板一致 -->
      <view class="task-icon"><text>{{item.categoryIcon || '📝'}}</text></view>
      <!-- 任务主体 -->
      <view class="task-main">
        <view class="task-tags">
          <text class="tag-domain" wx:if="{{item.domainName}}">{{item.domainName}}</text>
          <text class="tag-status tag-status-{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <text class="task-name {{item.status === 'overdue' ? 'overdue' : ''}}">{{item.name}}</text>
        <text class="task-description" wx:if="{{item.description && item.status !== 'overdue'}}">{{item.description}}</text>
        <view class="task-meta">
          <text class="task-instance">{{item.instanceLabel}}</text>
          <text class="task-period" wx:if="{{item.periodLabel}}">· {{item.periodLabel}}</text>
          <text class="task-progress" wx:if="{{item.periodTotal > 1}}">· 第 {{item.periodIndex}}/{{item.periodTotal}} 次</text>
        </view>
        <text class="task-range">有效期 {{item.rangeLabel}}</text>
        <view class="task-starts" wx:if="{{item.startsInLabel}}">
          <text>{{item.startsInLabel}}</text>
        </view>
      </view>
      <!-- 积分标签 -->
      <view class="task-reward">
        <text class="points" wx:if="{{item.status !== 'overdue'}}">+{{item.basePoints}}</text>
        <text class="points-label" wx:if="{{item.status !== 'overdue'}}">积分</text>
        <text class="done-text" wx:if="{{item.status === 'completed'}}">已完成</text>
        <text class="expired-text" wx:if="{{item.status === 'overdue'}}">已失效</text>
      </view>
      <text class="task-chevron" wx:if="{{item.status === 'active' || item.status === 'pending'}}">›</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && displayTasks.length === 0}}">
    <text class="empty-emoji">{{emptyEmoji}}</text>
    <text class="empty-text">{{emptyText}}</text>
    <text class="empty-hint">{{emptyHint}}</text>
    <button class="empty-button" bindtap="onAddTask" wx:if="{{currentStatus !== 'overdue'}}">添加任务</button>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>正在整理任务…</text>
  </view>
</view>
