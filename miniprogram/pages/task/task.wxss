/* pages/task/task.wxss | 任务列表页样式 v4.0 */
/* Friendly Flat Design */

/* ==================== 孩子选择器 ==================== */
.child-selector {
  background: var(--color-surface);
  padding: 20rpx 0;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--color-border);
}

.child-list {
  padding: 0 20rpx;
  display: flex;
}

.child-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: var(--color-surface-hover);
  border-radius: var(--radius-full);
  transition: all var(--transition-fast);
}

.child-tab.active {
  background: var(--color-primary);
}

.tab-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  overflow: hidden;
}

.tab-avatar image {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.child-tab.active .tab-avatar {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.tab-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.child-tab.active .tab-name {
  color: #FFFFFF;
}

/* ==================== 分类标签栏 ==================== */
.category-bar {
  background: var(--color-surface);
  padding: 16rpx 20rpx 20rpx;
  white-space: nowrap;
  border-bottom: 1rpx solid var(--color-border);
}

.category-list {
  display: flex;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  background: var(--color-surface-hover);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  color: var(--color-text-secondary);
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.category-item.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.cat-icon-wrap {
  margin-right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-emoji {
  font-size: 28rpx;
}

/* ==================== 任务列表 ==================== */
.task-list {
  height: calc(100vh - 340rpx);
  padding: 20rpx 24rpx;
}

.task-card {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.task-card:active {
  background: var(--color-surface-hover);
  transform: scale(0.98);
}

.task-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: rgba(59, 130, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.task-emoji {
  font-size: 48rpx;
}

.task-content {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 6rpx;
}

.task-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-meta .tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
}

.task-points {
  text-align: right;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.points-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  display: block;
  line-height: 1;
  margin-bottom: 4rpx;
}

.points-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state .empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.empty-state .empty-hint {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 加载状态 ==================== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
  color: var(--color-text-tertiary);
}

/* ==================== 浮动按钮 ==================== */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.4);
  z-index: 100;
  transition: all var(--transition-fast);
}

.fab:active {
  transform: scale(0.92);
  background: var(--color-primary-dark);
}

.fab-icon {
  font-size: 64rpx;
  font-weight: 300;
  color: #FFFFFF;
  line-height: 1;
}
