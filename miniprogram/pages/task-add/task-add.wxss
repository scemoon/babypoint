/* task-add.wxss - 复用 app.wxss 中的 .page-intro 风格 */
.edit-page { padding-top: 24rpx; padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

/* 编辑页顶部：与 .page-intro 保持一致 */
.edit-intro {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: -26rpx -28rpx 22rpx;
  padding: 32rpx 28rpx 26rpx;
  background: var(--grad-water);
  color: #FFF;
  overflow: hidden;
}
.edit-intro::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--lime) 50%, transparent 100%);
}
.edit-intro .eyebrow { color: var(--on-dark-faint); font-size: 21rpx; }
.edit-intro .page-title { color: #FFF; font-size: 36rpx; font-weight: 750; letter-spacing: -0.5rpx; }
.edit-intro .intro-hint { color: var(--on-dark-faint); font-size: 23rpx; margin-top: 4rpx; line-height: 1.5; }

.edit-badge {
  display: flex; align-items: center; justify-content: center;
  width: 62rpx; height: 62rpx; margin-bottom: 10rpx;
  border-radius: 17rpx 17rpx 5rpx 17rpx;
  background: var(--gold);
}
.edit-badge.reward-badge { background: var(--water); }

.form-section { padding: 24rpx; border: 1rpx solid var(--line); border-radius: 20rpx; background: var(--paper); box-shadow: var(--shadow-card); }
.form-item { margin-bottom: 20rpx; }
.label { display: block; margin-bottom: 8rpx; color: var(--label); font-size: 22rpx; font-weight: 650; }
.optional { color: var(--hint); font-size: 19rpx; font-weight: 400; }
.input, .picker-value { width: 100%; min-height: 84rpx; padding: 20rpx; font-size: 25rpx; }
.picker-value { display: flex; align-items: center; justify-content: space-between; }
.period-options { display: flex; flex-wrap: wrap; gap: 10rpx; }
.period-chip { padding: 13rpx 18rpx; border: 1rpx solid var(--line); border-radius: var(--radius-pill); background: var(--paper); color: var(--muted); font-size: 21rpx; }
.period-chip.active { background: var(--soft-water); border-color: var(--water-lo); color: var(--ink); font-weight: 700; }
.points-input { display: flex; align-items: center; gap: 12rpx; }
.points-input input { flex: 1; }
.points-input > text { color: var(--muted); font-size: 23rpx; }
.score-analysis {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  margin-top: 18rpx; padding: 20rpx 22rpx; border-radius: 16rpx;
  background: var(--grad-water);
  color: #FFF;
}
.score-analysis-copy { display: flex; flex-direction: column; gap: 5rpx; }
.score-analysis-label { color: var(--on-dark-faint); font-size: 23rpx; font-weight: 700; }
.score-analysis-reason { color: var(--on-dark-faint); font-size: 20rpx; }
.score-analysis-points { display: flex; align-items: baseline; gap: 6rpx; white-space: nowrap; }
.score-analysis-points text:first-child { color: var(--sun); font-family: 'DIN Alternate', sans-serif; font-size: 42rpx; font-weight: 700; }
.score-analysis-points text:last-child { color: var(--on-dark-faint); font-size: 18rpx; }
.textarea { width: 100%; min-height: 150rpx; padding: 18rpx; font-size: 24rpx; }
.form-hint { margin-top: 10rpx; font-size: 20rpx; }
.save-button { position: fixed; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 5; width: auto; height: 96rpx; border-radius: 20rpx; }
