<wxs module="utils">
module.exports = {
  // 记录时间是毫秒时间戳，直接渲染会显示成一串数字，这里统一成「10月11日 19:30」
  // 与首页「最近兑换」的写法保持一致。
  formatTime: function(timestamp) {
    if (!timestamp) return '';
    var d = getDate(timestamp);
    var hour = d.getHours();
    var min = d.getMinutes();
    return [d.getMonth() + 1, '月', d.getDate(), '日'].join('') + ' ' +
      [hour, min].map(function(v){ return v < 10 ? '0' + v : v; }).join(':');
  }
}
</wxs>

<view class="container history-page">
  <view class="page-intro"><text class="eyebrow">回看每一天的积累</text><text class="page-title">积分记录</text></view>

  <scroll-view scroll-x class="child-strip" wx:if="{{children.length > 1}}">
    <view class="child-strip-inner">
      <view class="child-pill {{item._id === selectedChild._id ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}">
        <view class="tiny-avatar"><text wx:if="{{!item.avatar}}">{{item.name[0]}}</text><image wx:else src="{{item.avatar}}" mode="aspectFill"/></view><text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="calendar-section">
    <view class="month-heading"><view class="month-control" bindtap="onPrevMonth">‹</view><text>{{year}}年{{month}}月</text><view class="month-control" bindtap="onNextMonth">›</view></view>
    
    <view class="calendar-board">
      <view class="weekday-row"><text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text></view>
      <view class="days-grid">
        <view class="day-cell {{item.hasActivity ? 'has-activity' : ''}} {{selectedDate === item.date ? 'selected' : ''}} {{item.empty ? 'day-empty' : ''}}" wx:for="{{days}}" wx:key="key" bindtap="onDayTap" data-date="{{item.date}}">
          <text class="day-number">{{item.dayLabel}}</text>
          <text class="day-earned" wx:if="{{item.totalEarned > 0}}">+{{item.totalEarned}}</text>
          <text class="day-zero" wx:if="{{!item.empty && !item.hasActivity}}">0</text>
        </view>
      </view>
    </view>
    <view class="calendar-hint">点选日期，查看当天的积分记录</view>
  </view>

  <view class="records-heading"><text class="section-title">{{selectedDate ? selectedDate + ' 的记录' : '积分明细'}}</text></view>
  <view class="record-switch">
    <view class="{{type === 'task' ? 'active' : ''}}" bindtap="onTypeChange" data-type="task">任务获得</view>
    <view class="{{type === 'reward' ? 'active' : ''}}" bindtap="onTypeChange" data-type="reward">奖励兑换</view>
  </view>
  <view class="record-list" wx:if="{{records.length}}">
    <view class="record-row" wx:for="{{records}}" wx:key="_id">
      <view class="record-symbol {{type === 'task' ? 'earned' : 'spent'}}"><icon name="{{type === 'task' ? 'check' : 'gift'}}" size="34" color="{{type === 'task' ? '#177078' : '#B93E24'}}"/></view>
      <view class="record-main"><text class="record-name">{{type === 'task' ? item.taskName : item.rewardName}}</text><text class="record-time">{{utils.formatTime(item.completedAt || item.redeemedAt || item.createdAt)}}</text><text class="record-level" wx:if="{{type === 'task' && item.completionLevel}}">{{item.completionLevel === 'perfect' ? '完成得很棒' : item.completionLevel === 'normal' ? '按计划完成' : '完成基础目标'}}</text></view>
      <text class="record-points {{type === 'task' ? 'plus' : 'minus'}}">{{type === 'task' ? '+' + item.actualPoints : '−' + (item.pointsRequired || item.pointsSpent || 0)}}</text>
    </view>
  </view>
  <view class="loading" wx:if="{{loading}}">正在加载记录…</view>
  <view class="empty-state" wx:if="{{!loading && records.length === 0}}"><icon name="history" size="58" color="#12807A"/><text class="empty-text">{{selectedDate ? '这一天没有' : '还没有'}}{{type === 'task' ? '任务' : '兑换'}}记录</text><text class="empty-hint">{{selectedDate ? '可以选择其他日期查看积分变化。' : (type === 'task' ? '完成一项任务后，积分变化会显示在这里。' : '兑换奖励后，可以在这里查看积分使用情况。')}}</text></view>
  <view class="no-more" wx:if="{{!loading && !selectedDate && !hasMore && records.length > 0}}">已经到底了</view>
</view>
