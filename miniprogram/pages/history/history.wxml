<!--pages/history/history.wxml-->
<view class="container">
  <scroll-view scroll-x class="child-bar">
    <view class="child-list">
      <view class="child-item {{item._id === selectedChild._id ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}">
        <view class="tab-avatar">
          <text wx:if="{{!item.avatar}}">{{item.name[0]}}</text>
          <image wx:else src="{{item.avatar}}"/>
        </view>
        <text class="tab-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
  
  <view class="record-list">
    <view class="record-item" wx:for="{{records}}" wx:key="_id">
      <view class="record-left">
        <view class="record-icon-wrap {{type === 'task' ? 'task-icon' : 'reward-icon'}}">
          <icon name="{{type === 'task' ? 'list' : 'gift'}}" size="44" color="{{type === 'task' ? '#FF8B45' : '#4ECDC4'}}"/>
        </view>
        <view class="record-info">
          <text class="record-name" wx:if="{{type === 'task'}}">{{item.taskName}}</text>
          <text class="record-name" wx:else>{{item.rewardName}}</text>
          <text class="record-time">{{item.completedAt || item.redeemedAt}}</text>
        </view>
      </view>
      <view class="record-right">
        <text class="points {{type === 'task' ? 'earn' : 'spend'}}">{{type === 'task' ? '+' : '-'}}{{type === 'task' ? item.actualPoints : item.pointsSpent}}</text>
        <view class="tag tag-{{item.completionLevel || 'normal'}}" wx:if="{{type === 'task' && item.completionLevel}}">
          <text>{{item.completionLevel === 'perfect' ? '完美' : item.completionLevel === 'normal' ? '一般' : '简单'}}</text>
        </view>
      </view>
    </view>
    <view class="loading-tip" wx:if="{{loading}}"><text>加载中...</text></view>
    <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
      <icon name="history" size="100" color="#E5E7EB"/>
      <text class="empty-text">暂无记录</text>
    </view>
    <view class="no-more" wx:if="{{!loading && !hasMore && records.length > 0}}"><text>— 没有更多了 —</text></view>
  </view>
</view>
