/* pages/task-complete/task-complete.wxss */
.container {
  padding: 30rpx;
  min-height: 100vh;
  background: #F7F7F7;
}

.task-card {
  background: linear-gradient(135deg, #FF8B45 0%, #FF6B35 100%);
  border-radius: 24rpx;
  padding: 50rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 30rpx;
}

.task-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.task-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.base-points {
  font-size: 28rpx;
  opacity: 0.9;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.child-list {
  display: flex;
  flex-direction: row;
}

.child-item {
  padding: 20rpx 40rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.child-item.active {
  background: #FF8B45;
  color: #fff;
}

.level-list {
  display: flex;
  flex-direction: row;
}

.level-item {
  flex: 1;
  background: #f9f9f9;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  border: 4rpx solid transparent;
  margin-right: 20rpx;
}

.level-item:last-child {
  margin-right: 0;
}

.level-item.active {
  border-color: #FF8B45;
  background: #FFF5F0;
}

.level-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.level-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.level-ratio {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF8B45;
  display: block;
}

.preview-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-label {
  font-size: 30rpx;
  color: #666;
}

.preview-points {
  font-size: 60rpx;
  font-weight: bold;
  color: #FF8B45;
  margin-left: 20rpx;
  margin-right: 10rpx;
}

.preview-ratio {
  font-size: 28rpx;
  color: #999;
}

.submit-btn {
  background: #FF8B45;
  color: #fff;
  border-radius: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}
