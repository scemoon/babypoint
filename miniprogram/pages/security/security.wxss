/* security.wxss - 安全设置页 */
.security-page {
  padding-top: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 安全页顶部：与 .page-intro 风格一致 */
.security-intro {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: -26rpx -28rpx 24rpx;
  padding: 32rpx 28rpx 26rpx;
  background: var(--grad-water);
  color: #FFF;
  overflow: hidden;
}
.security-intro::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, var(--lime) 50%, transparent 100%);
}
.security-intro .eyebrow { color: var(--on-dark-faint); font-size: 22rpx; }
.security-intro .page-title { color: #FFF; font-size: 38rpx; font-weight: 750; letter-spacing: -0.5rpx; }
.intro-copy { max-width: 620rpx; color: var(--on-dark-faint); font-size: 22rpx; line-height: 1.6; margin-top: 4rpx; }

.security-form {
  padding: 22rpx;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow-card);
}
.form-item { margin-bottom: 20rpx; }
.form-item:last-child { margin-bottom: 0; }
.field-label { display: block; margin-bottom: 8rpx; color: var(--label); font-size: 22rpx; font-weight: 650; }
.security-input {
  min-height: 84rpx;
  padding: 18rpx;
  border-radius: var(--radius-sm);
  background: var(--mist);
  font-size: 28rpx;
  letter-spacing: 10rpx;
  border: 1rpx solid var(--line);
  color: var(--ink);
}
.security-note {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-left: 4rpx solid var(--water);
  background: var(--soft-water);
  color: var(--label);
  font-size: 21rpx;
  line-height: 1.5;
}
.note-title { color: var(--ink); font-weight: 700; }

.save-button {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 5;
  width: auto;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--gold);
  color: var(--ink);
  font-weight: 700;
  box-shadow: var(--shadow-fab);
}
