<view class="container publish-page">
  <!-- 页面标题：扁平页头，不用渐变面板 -->
  <view class="page-intro page-intro-flat">
    <text class="eyebrow">🌸 攒星卡 · 成长激励</text>
  </view>

  <!-- 孩子切换器 -->
  <scroll-view scroll-x class="child-strip" wx:if="{{children.length > 1}}">
    <view class="child-strip-inner">
      <view class="child-pill {{item._id === selectedChildId ? 'active' : ''}}" wx:for="{{children}}" wx:key="_id" bindtap="onSelectChild" data-id="{{item._id}}">
        <view class="tiny-avatar"><text wx:if="{{!item.avatar}}">{{item.name[0]}}</text><image wx:else src="{{item.avatar}}" mode="aspectFill"/></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- ========== 自定义任务 ========== -->
  <view class="section-heading">
    <view>
      <text class="section-number">01</text>
      <text class="section-title">自定义任务</text>
    </view>
    <text class="section-note">按需设置</text>
  </view>

  <view class="form-card">
    <!-- 任务名称 -->
    <view class="form-item">
      <text class="label">任务名称</text>
      <input class="input" placeholder="例如：整理书桌" maxlength="30" bindinput="onNameInput" value="{{formData.name}}" cursor-spacing="24" />
    </view>

    <!-- 任务分类 -->
    <view class="form-row">
      <view class="form-item category-item">
        <text class="label">任务分类</text>
        <picker mode="selector" range="{{categories}}" range-key="name" bindchange="onCategoryChange">
          <view class="picker-value">
            {{selectedCategoryName || '选择分类'}}
            <text class="picker-arrow">⌄</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 任务周期 -->
    <view class="form-row">
      <view class="form-item" style="width: 100%;">
        <text class="label">任务周期</text>
        <view class="period-options">
          <view wx:for="{{periods}}" wx:key="key" class="period-chip {{formData.periodType === item.key ? 'active' : ''}}" data-type="{{item.key}}" bindtap="onPeriodTap">
            {{item.name}}
          </view>
        </view>
      </view>
    </view>

    <!-- 任务时间段：起止日期决定任务页里会展开出哪些周期 -->
    <view class="form-row">
      <view class="form-item" style="width: 100%;">
        <text class="label">任务时间段 <text class="optional">{{rangeHint}}</text></text>
        <view class="range-row">
          <picker mode="date" value="{{startDateStr}}" start="{{rangeStart}}" bindchange="onStartDateChange">
            <view class="range-field">
              <text class="range-field-label">开始</text>
              <text class="range-field-value">{{startDateStr}}</text>
            </view>
          </picker>
          <text class="range-arrow">→</text>
          <picker mode="date" value="{{endDateStr}}" start="{{startDateStr || rangeStart}}" bindchange="onEndDateChange">
            <view class="range-field">
              <text class="range-field-label">结束</text>
              <text class="range-field-value">{{endDateStr}}</text>
            </view>
          </picker>
        </view>
        <view class="range-summary" wx:if="{{rangeSummary}}">
          <text class="range-summary-text">{{rangeSummary}}</text>
        </view>
      </view>
    </view>

    <!-- 完成要求 -->
    <view class="form-item">
      <view class="label-row">
        <text class="label">完成要求 <text class="optional">选填</text></text>
        <view class="smart-score" wx:if="{{scorePreview}}">
          <text class="smart-score-value">{{scorePreview}}</text>
          <text class="smart-score-unit">积分/次</text>
        </view>
      </view>
      <textarea class="task-description" placeholder="例如：独立完成当天作业，预计30分钟" bindinput="onDescriptionInput" value="{{formData.description}}" maxlength="120" cursor-spacing="24"/>
    </view>

    <view class="action-row">
      <button class="create-button" bindtap="onCustomSubmit" loading="{{loading}}">＋ 创建任务</button>
      <button class="growth-plan-btn" bindtap="onOpenGrowthPlan">📅 年度成长</button>
    </view>
  </view>

  <!-- ========== 任务模板库 ========== -->
  <view class="section-heading preset-heading">
    <view>
      <text class="section-number">03</text>
      <text class="section-title">任务模板库</text>
    </view>
    <text class="section-note">{{displayPresets.length}} 项</text>
  </view>

  <view class="library-note">🌱 选择适合孩子年龄的任务模板，点「+」确认后添加</view>

  <!-- 筛选工具栏 -->
  <view class="preset-toolbar">
    <view class="preset-search">
      <text class="search-icon">⌕</text>
      <input placeholder="搜索任务" value="{{presetKeyword}}" bindinput="onPresetSearchInput" cursor-spacing="24"/>
    </view>
  </view>

  <!-- 五育领域筛选 -->
  <view class="filter-card">
    <view class="filter-card-head">
      <text class="filter-card-title">领域筛选</text>
      <text class="filter-card-hint">按五育领域快速定位</text>
    </view>
    <scroll-view scroll-x class="preset-period-scroll" enhanced show-scrollbar="{{false}}">
      <view class="preset-period-pills">
        <view wx:for="{{presetDomains}}" wx:key="key" class="preset-period-pill {{presetDomain === item.key ? 'active' : ''}}" bindtap="onPresetDomainTap" data-key="{{item.key}}">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 分类筛选：图标卡片网格 -->
  <view class="filter-card">
    <view class="filter-card-head">
      <text class="filter-card-title">分类筛选</text>
      <text class="filter-card-hint">{{presetDomain ? '已按领域筛选' : '点选查看对应模板'}}</text>
    </view>
    <view class="preset-cat-grid">
      <view wx:for="{{displayCategories}}" wx:key="key" class="preset-cat-tile {{presetCategory === item.key ? 'active' : ''}}" bindtap="onPresetCategoryTap" data-key="{{item.key}}">
        <text class="preset-cat-tile-name">{{item.name}}</text>
        <text class="preset-cat-domain-tag" wx:if="{{item.domainName}}">{{item.domainName}}</text>
      </view>
    </view>
  </view>

  <!-- 周期筛选：紧凑标签 -->
  <view class="filter-card">
    <view class="filter-card-head">
      <text class="filter-card-title">周期筛选</text>
      <text class="filter-card-hint">多选组合更精准</text>
    </view>
    <scroll-view scroll-x class="preset-period-scroll" enhanced show-scrollbar="{{false}}">
      <view class="preset-period-pills">
        <view wx:for="{{presetPeriods}}" wx:key="key" class="preset-period-pill {{presetPeriod === item.key ? 'active' : ''}}" bindtap="onPresetPeriodTap" data-key="{{item.key}}">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 模板列表 -->
  <view class="preset-list" wx:if="{{displayPresets.length}}">
    <view class="preset-row" wx:for="{{displayPresets}}" wx:key="name" bindtap="onPresetTap" data-task="{{item}}">
      <view class="preset-icon">{{item.icon}}</view>
      <view class="preset-info">
        <view class="preset-header">
          <text class="preset-name">{{item.name}}</text>
        </view>
        <text class="preset-description">{{item.description}}</text>
        <view class="preset-meta">
          <text class="preset-period">{{item.periodLabel}}</text>
          <text class="preset-domain">{{item.basePoints}} 积分</text>
        </view>
      </view>
      <view class="preset-action">
        <text class="preset-add">＋</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="library-empty" wx:else>
    <text>没有匹配的任务</text>
    <text class="empty-hint">换个关键词或分类试试</text>
  </view>

  <!-- 键盘占位：撑出可滚动余量，把输入框推到键盘之上（收起时高度为 0） -->
  <view class="keyboard-spacer" style="height: {{keyboardHeight}}px"></view>

  <!-- ========== 智能年成长计划弹窗 ========== -->
  <view class="growth-modal-mask {{showGrowthPlan ? 'active' : ''}}" bindtap="onCloseGrowthPlan"></view>
  <view class="growth-modal {{showGrowthPlan ? 'active' : ''}}">
    <!-- 弹窗头部 -->
    <view class="growth-modal-header">
      <view class="growth-modal-drag"></view>
      <view class="growth-modal-title-row">
        <text class="growth-modal-title">📅 智能年成长计划</text>
        <text class="growth-modal-close" bindtap="onCloseGrowthPlan">✕</text>
      </view>
    </view>

    <scroll-view scroll-y class="growth-modal-content">
      <!-- 没有孩子时的提示 -->
      <view class="growth-empty-tip" wx:if="{{!hasChildrenInPlan}}">
        <text class="growth-empty-icon">👶</text>
        <text class="growth-empty-text">请先在「我的」页面添加孩子</text>
        <text class="growth-empty-sub">添加孩子后，才能生成专属的年度成长计划</text>
        <view class="growth-empty-btn" bindtap="onCloseGrowthPlan">去添加孩子</view>
      </view>

      <!-- 有孩子时显示年级选择 -->
      <block wx:if="{{hasChildrenInPlan}}">
      <!-- 第一部分：年级选择 -->
      <view class="growth-section">
        <view class="grade-grid">
          <view wx:for="{{grades}}" wx:key="key" 
                class="grade-item {{selectedGrade === item.key ? 'active' : ''}}" 
                bindtap="onGradeSelect" data-grade="{{item.key}}">
            <text class="grade-icon">{{item.icon}}</text>
            <text class="grade-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 第二部分：成长规划预览 -->
      <view class="growth-section" wx:if="{{selectedGrade}}">
        <view class="growth-section-title">📋 从现在到年底的成长规划</view>
        <view class="growth-summary">
          <text class="growth-summary-text">基于{{currentMonthName}}至12月，智能安排 {{growthPlan.totalTasks}} 个任务，覆盖 {{growthPlan.coveredMonths}} 个月</text>
        </view>

        <!-- 规划时间轴 -->
        <view class="growth-timeline">
          <view wx:for="{{growthPlan.phases}}" wx:key="name" class="growth-phase">
            <view class="growth-phase-header">
              <text class="growth-phase-name">{{item.name}}</text>
              <text class="growth-phase-date">{{item.dateRange}}</text>
            </view>
            <view class="growth-phase-tasks">
              <view wx:for="{{item.tasks}}" wx:key="name" wx:for-index="taskIdx" class="growth-task-item" bindtap="onToggleGrowthTask" data-task-idx="{{taskIdx}}" data-phase-idx="{{index}}">
                <view class="growth-task-checkbox {{item.selected ? 'checked' : ''}}">
                  <text wx:if="{{item.selected}}">✓</text>
                </view>
                <view class="growth-task-info">
                  <view class="growth-task-header">
                    <text class="growth-task-icon">{{item.icon}}</text>
                    <text class="growth-task-name">{{item.name}}</text>
                  </view>
                  <view class="growth-task-tags">
                    <text class="growth-task-domain {{item.domain}}">{{item.domainName}}</text>
                    <text class="growth-task-period">{{item.periodLabel}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      </block>
    </scroll-view>

    <!-- 底部确认栏 -->
    <view class="growth-modal-footer" wx:if="{{selectedGrade}}">
      <view class="growth-selected-info">
        <text>已选 {{selectedGrowthTasksCount}} 个任务</text>
      </view>
      <button class="growth-confirm-btn" bindtap="onConfirmGrowthPlan" disabled="{{selectedGrowthTasksCount === 0}}">
        一键添加 {{selectedGrowthTasksCount > 0 ? selectedGrowthTasksCount : ''}} 个任务
      </button>
    </view>
  </view>
</view>
