/* publish.wxss - 发布页 */
.publish-page { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }

/* ========== 孩子切换器 ========== */
.child-strip { width: calc(100% + 56rpx); margin-left: -28rpx; white-space: nowrap; }
.child-strip-inner { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 28rpx; }
.child-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 22rpx;
  transition: all .15s ease;
}
.child-pill.active {
  background: var(--ink);
  border-color: var(--ink);
  color: #FFF;
}
.tiny-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--water);
  color: #FFF;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.tiny-avatar image { width: 100%; height: 100%; }

/* ========== 段落标题 ========== */
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 2rpx 16rpx;
}
.section-heading > view { display: flex; align-items: center; gap: 12rpx; }
.section-number { color: var(--water-lo); font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.section-title { color: var(--ink); font-size: 29rpx; font-weight: 750; }
.section-note { color: var(--hint); font-size: 21rpx; }

/* ========== 自定义任务表单 ========== */
.form-card {
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.form-item { min-width: 0; margin-bottom: 22rpx; }
.label {
  display: block;
  margin-bottom: 9rpx;
  color: var(--label);
  font-size: 22rpx;
  font-weight: 650;
}
.input, .picker-value {
  width: 100%;
  min-height: 82rpx;
  padding: 18rpx;
  font-size: 24rpx;
}
.form-row { display: flex; gap: 16rpx; }
.category-item { flex: 1.2; }
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-arrow { color: var(--muted); }
.points-input { display: flex; align-items: center; gap: 10rpx; }
.points-input input { flex: 1; min-width: 0; }
.points-input > text { color: var(--muted); font-size: 22rpx; }
.optional { color: var(--hint); font-size: 19rpx; font-weight: 400; }
.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 9rpx;
}
.label-row .label { margin-bottom: 0; }
.smart-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: var(--soft-gold);
}
.smart-score-value {
  font-family: 'DIN Alternate', sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--gold-dark);
}
.smart-score-unit { font-size: 18rpx; color: var(--gold-dark); }
.task-description {
  width: 100%;
  min-height: 60rpx;
  padding: 18rpx;
  font-size: 23rpx;
  box-sizing: border-box;
}

/* 任务周期 */
.period-options { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.period-chip {
  padding: 13rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 21rpx;
  transition: all .12s ease;
}
.period-chip.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
  color: var(--ink);
  font-weight: 700;
}
.period-custom { display: inline-flex; align-items: center; gap: 10rpx; flex-wrap: nowrap; }
.period-custom-input {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--ink);
  color: #FFF;
}
.custom-prefix, .custom-suffix { font-size: 21rpx; font-weight: 650; }
.custom-num-input {
  width: 64rpx;
  min-width: 64rpx;
  padding: 0 4rpx;
  border: 0;
  background: transparent;
  color: #FFF;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}
.custom-num-input::placeholder { color: var(--on-dark-faint); }

/* 任务时间段：开始 — 结束 两个日期选择器 */
.range-row { display: flex; align-items: center; gap: 12rpx; }
.range-row > picker { flex: 1; min-width: 0; }
.range-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 82rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-sizing: border-box;
}
.range-field-label { color: var(--hint); font-size: 21rpx; }
.range-field-value { color: var(--ink); font-size: 23rpx; font-weight: 700; }
.range-arrow { color: var(--hint); font-size: 22rpx; }
.range-summary { margin-top: 10rpx; }
.range-summary-text { color: var(--water-lo); font-size: 20rpx; font-weight: 600; }

/* 积分分析：浅青底卡片（原为深色渐变面板；浅底上必须配深字，
   否则积分数字上一版是「蜜黄字 + 浅黄绿底」、单位是「近白字 + 浅黄绿底」，都看不清）*/
.score-analysis {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 16rpx 0 8rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--soft-water);
  color: var(--ink);
}
.score-analysis > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.score-analysis-label { color: var(--water-lo); font-size: 22rpx; font-weight: 700; }
.score-analysis-reason { color: var(--muted); font-size: 19rpx; }
.score-info { flex: 1; }
.score-points {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--soft-gold);
}
.points-value {
  font-family: 'DIN Alternate', sans-serif;
  font-size: 42rpx;
  font-weight: 800;
  color: var(--gold-dark);
}
.points-unit { font-size: 18rpx; color: var(--gold-dark); }
.score-policy {
  margin-bottom: 18rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.45;
}
.create-button {
  flex: 1;
  height: 88rpx;
  margin-top: 4rpx;
  border-radius: var(--radius-md);
  background: var(--gold);
}
.action-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}
.growth-plan-btn {
  flex-shrink: 0;
  width: 220rpx;
  height: 88rpx;
  margin-top: 4rpx;
  border-radius: var(--radius-md);
  background: var(--soft-water);
  color: var(--water-lo);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 任务模板库 ========== */
.preset-heading { margin-top: 34rpx; }
.library-note {
  margin: -7rpx 2rpx 16rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

/* 搜索工具栏 */
.preset-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.preset-search {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 68rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
}
.search-icon { color: var(--water-lo); font-size: 34rpx; line-height: 1; }
.preset-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 23rpx;
}

/* 过滤卡片（通用样式在 app.wxss） */
.filter-card {
  margin-top: 14rpx;
  padding: 22rpx 22rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.filter-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.filter-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.filter-card-hint { font-size: 20rpx; color: var(--hint); }

/* 分类筛选 */
.preset-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.preset-cat-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 6rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 550;
  transition: all .12s ease;
  min-height: 70rpx;
}
.preset-cat-tile:active { transform: scale(.96); }
.preset-cat-tile.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
  color: var(--ink);
  font-weight: 700;
}
.preset-cat-tile-name {
  white-space: nowrap;
}
.preset-cat-domain-tag {
  font-size: 16rpx;
  color: var(--muted);
  white-space: nowrap;
  margin-top: 4rpx;
}
.preset-cat-tile.active .preset-cat-domain-tag {
  color: var(--ink);
}

/* 周期筛选 */
.preset-period-scroll { width: calc(100% + 44rpx); margin-left: -22rpx; white-space: nowrap; }
.preset-period-pills {
  display: flex;
  gap: 10rpx;
  padding: 4rpx 22rpx;
  align-items: center;
  white-space: nowrap;
}
.preset-period-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 22rpx;
  white-space: nowrap;
  transition: all .12s ease;
}
.preset-period-pill:active { transform: scale(.96); }
.preset-period-pill.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
  color: var(--ink);
  font-weight: 700;
}

/* 模板列表 */
.preset-list {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.preset-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background .12s ease;
}
.preset-row:active { background: var(--mist); }
.preset-row:last-child { border-bottom: 0; }
.preset-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: var(--soft-lime);
  font-size: 32rpx;
}
.preset-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 4rpx;
}
.preset-header { display: flex; align-items: center; gap: 8rpx; }
.preset-name { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.preset-description {
  overflow: hidden;
  color: var(--muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preset-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 4rpx; }
.preset-period {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: var(--soft-water);
  color: var(--water-lo);
  font-size: 18rpx;
  font-weight: 600;
}
.preset-domain { color: var(--muted); font-size: 18rpx; font-weight: 600; }
.preset-action { display: flex; align-items: center; justify-content: center; }
.preset-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: var(--soft-water);
  color: var(--water-lo);
  font-size: 36rpx;
  font-weight: 300;
}

/* 空状态 */
.library-empty {
  padding: 52rpx 24rpx;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius-md);
  color: var(--muted);
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
}
.library-empty .empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--hint);
}

/* ========== 智能年成长计划 ========== */
.smart-plan-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--soft-water) 0%, var(--soft-lime) 100%);
  box-shadow: var(--shadow-card);
  transition: transform .12s ease;
}
.smart-plan-card:active { transform: scale(.98); }
.smart-plan-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: var(--paper);
  font-size: 40rpx;
}
.smart-plan-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.smart-plan-title {
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}
.smart-plan-desc {
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.4;
}
.smart-plan-arrow {
  color: var(--water-lo);
  font-size: 48rpx;
  font-weight: 300;
}

/* ========== 成长计划弹窗 ========== */
.growth-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, .5);
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s ease;
  z-index: 1000;
}
.growth-modal-mask.active {
  opacity: 1;
  pointer-events: auto;
}
.growth-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background: var(--paper);
  border-radius: 32rpx 32rpx 0 0;
  transition: height .3s ease;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.growth-modal.active {
  height: 95vh;
}

/* 弹窗头部 */
.growth-modal-header {
  flex-shrink: 0;
  padding: 16rpx 24rpx 20rpx;
  border-bottom: 1rpx solid var(--line);
}
.growth-modal-drag {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 4rpx;
  background: var(--line);
}
.growth-modal-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.growth-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.growth-modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--mist);
  color: var(--muted);
  font-size: 28rpx;
}

/* 弹窗内容 */
.growth-modal-content {
  flex: 1;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 无孩子时的提示 */
.growth-empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}
.growth-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.growth-empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}
.growth-empty-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 40rpx;
}
.growth-empty-btn {
  padding: 20rpx 48rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 成长阶段 */
.growth-section {
  margin-bottom: 32rpx;
}
.growth-section-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

/* 年级选择 */
.grade-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
}
.grade-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx;
  min-height: 120rpx;
  border: 2rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  transition: all .12s ease;
}
.grade-item:active { transform: scale(.96); }
.grade-item.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
}
.grade-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}
.grade-name {
  font-size: 20rpx;
  color: var(--ink);
  font-weight: 600;
}

/* 成长规划摘要 */
.growth-summary {
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: var(--radius-sm);
  background: var(--soft-gold);
}
.growth-summary-text {
  font-size: 22rpx;
  color: var(--gold-dark);
  font-weight: 600;
}

/* 时间轴 */
.growth-timeline {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.growth-phase {
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
}
.growth-phase-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.growth-phase-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.growth-phase-date {
  font-size: 20rpx;
  color: var(--muted);
}
.growth-phase-tasks {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 任务项 */
.growth-task-item {
  display: flex;
  align-items: center;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-sm);
  background: var(--mist);
  transition: background .12s ease;
}
.growth-task-item:active { background: var(--line); }
.growth-task-checkbox {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
  flex-shrink: 0;
}
.growth-task-checkbox.checked {
  background: var(--water-lo);
  border-color: var(--water-lo);
  color: #fff;
  font-size: 24rpx;
}
.growth-task-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.growth-task-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.growth-task-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}
.growth-task-name {
  font-size: 22rpx;
  color: var(--ink);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.growth-task-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-left: 34rpx;
}
.growth-task-domain {
  font-size: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  font-weight: 500;
}
.growth-task-domain.intelligence { background: #E3F2FD; color: #1565C0; }
.growth-task-domain.physical { background: #E8F5E9; color: #2E7D32; }
.growth-task-domain.aesthetic { background: #FCE4EC; color: #AD1457; }
.growth-task-domain.moral { background: #FFF3E0; color: #E65100; }
.growth-task-domain.lifeSkill { background: #E0F7FA; color: #00838F; }
.growth-task-domain.other { background: #F5F5F5; color: #757575; }
.growth-task-period {
  font-size: 16rpx;
  color: var(--muted);
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background: var(--mist);
}

/* 底部确认栏 */
.growth-modal-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}
.growth-selected-info {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}
.growth-confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-md);
  background: var(--gold);
  color: var(--gold-dark);
  font-size: 28rpx;
  font-weight: 700;
}
.growth-confirm-btn[disabled] {
  background: var(--mist);
  color: var(--muted);
}
