/* publish.wxss - 发布页 */
.publish-page { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }

/* ========== 段落标题 ========== */
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 2rpx 16rpx;
}
.section-heading > view { display: flex; align-items: center; gap: 12rpx; }
.section-number { color: var(--water-lo); font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.section-title { color: var(--ink); font-size: 29rpx; font-weight: 750; }
.section-note { color: var(--hint); font-size: 21rpx; }

/* ========== 自定义任务表单 ========== */
.form-card {
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.form-item { min-width: 0; margin-bottom: 22rpx; }
.label {
  display: block;
  margin-bottom: 9rpx;
  color: var(--label);
  font-size: 22rpx;
  font-weight: 650;
}
.input, .picker-value {
  width: 100%;
  min-height: 82rpx;
  padding: 18rpx;
  font-size: 24rpx;
}
.form-row { display: flex; gap: 16rpx; }
.category-item { flex: 1.2; }
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.picker-arrow { color: var(--muted); }
.points-input { display: flex; align-items: center; gap: 10rpx; }
.points-input input { flex: 1; min-width: 0; }
.points-input > text { color: var(--muted); font-size: 22rpx; }
.optional { color: var(--hint); font-size: 19rpx; font-weight: 400; }
.task-description {
  width: 100%;
  min-height: 60rpx;
  padding: 18rpx;
  font-size: 23rpx;
  box-sizing: border-box;
}

/* 任务周期 */
.period-options { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.period-chip {
  padding: 13rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 21rpx;
  transition: all .12s ease;
}
.period-chip.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
  color: var(--ink);
  font-weight: 700;
}
.period-custom { display: inline-flex; align-items: center; gap: 10rpx; flex-wrap: nowrap; }
.period-custom-input {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid var(--ink);
  border-radius: 999rpx;
  background: var(--ink);
  color: #FFF;
}
.custom-prefix, .custom-suffix { font-size: 21rpx; font-weight: 650; }
.custom-num-input {
  width: 64rpx;
  min-width: 64rpx;
  padding: 0 4rpx;
  border: 0;
  background: transparent;
  color: #FFF;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}
.custom-num-input::placeholder { color: var(--on-dark-faint); }

/* 积分分析：浅青底卡片（原为深色渐变面板；浅底上必须配深字，
   否则积分数字上一版是「蜜黄字 + 浅黄绿底」、单位是「近白字 + 浅黄绿底」，都看不清）*/
.score-analysis {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin: 16rpx 0 8rpx;
  padding: 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--soft-water);
  color: var(--ink);
}
.score-analysis > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.score-analysis-label { color: var(--water-lo); font-size: 22rpx; font-weight: 700; }
.score-analysis-reason { color: var(--muted); font-size: 19rpx; }
.score-info { flex: 1; }
.score-points {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: var(--soft-gold);
}
.points-value {
  font-family: 'DIN Alternate', sans-serif;
  font-size: 42rpx;
  font-weight: 800;
  color: var(--gold-dark);
}
.points-unit { font-size: 18rpx; color: var(--gold-dark); }
.score-policy {
  margin-bottom: 18rpx;
  color: var(--muted);
  font-size: 19rpx;
  line-height: 1.45;
}
.create-button {
  width: 100%;
  height: 88rpx;
  margin-top: 4rpx;
  border-radius: var(--radius-md);
  background: var(--gold);
}

/* ========== 任务模板库 ========== */
.preset-heading { margin-top: 34rpx; }
.library-note {
  margin: -7rpx 2rpx 16rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

/* 搜索工具栏 */
.preset-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.preset-search {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 68rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
}
.search-icon { color: var(--water-lo); font-size: 34rpx; line-height: 1; }
.preset-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 23rpx;
}

/* 过滤卡片（通用样式在 app.wxss） */
.filter-card {
  margin-top: 14rpx;
  padding: 22rpx 22rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.filter-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.filter-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.filter-card-hint { font-size: 20rpx; color: var(--hint); }

/* 分类筛选 */
.preset-cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
}
.preset-cat-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 6rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 550;
  transition: all .12s ease;
}
.preset-cat-tile:active { transform: scale(.96); }
.preset-cat-tile.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
  color: var(--ink);
  font-weight: 700;
}

/* 周期筛选 */
.preset-period-scroll { width: calc(100% + 44rpx); margin-left: -22rpx; white-space: nowrap; }
.preset-period-pills {
  display: flex;
  gap: 10rpx;
  padding: 4rpx 22rpx;
  align-items: center;
  white-space: nowrap;
}
.preset-period-pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 22rpx;
  white-space: nowrap;
  transition: all .12s ease;
}
.preset-period-pill:active { transform: scale(.96); }
.preset-period-pill.active {
  background: var(--soft-water);
  border-color: var(--water-lo);
  color: var(--ink);
  font-weight: 700;
}

/* 模板列表 */
.preset-list {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  box-shadow: var(--shadow-card);
}
.preset-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx;
  border-bottom: 1rpx solid var(--line);
  transition: background .12s ease;
}
.preset-row:active { background: var(--mist); }
.preset-row:last-child { border-bottom: 0; }
.preset-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 18rpx;
  background: var(--soft-lime);
  font-size: 32rpx;
}
.preset-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 4rpx;
}
.preset-header { display: flex; align-items: center; gap: 8rpx; }
.preset-name { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.preset-description {
  overflow: hidden;
  color: var(--muted);
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.preset-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 4rpx; }
.preset-period {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: var(--soft-water);
  color: var(--water-lo);
  font-size: 18rpx;
  font-weight: 600;
}
.preset-domain { color: var(--muted); font-size: 18rpx; font-weight: 600; }
.preset-action { display: flex; align-items: center; justify-content: center; }
.preset-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: var(--soft-water);
  color: var(--water-lo);
  font-size: 36rpx;
  font-weight: 300;
}

/* 空状态 */
.library-empty {
  padding: 52rpx 24rpx;
  border: 1rpx dashed var(--line);
  border-radius: var(--radius-md);
  color: var(--muted);
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
}
.library-empty .empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--hint);
}
