.onboard-page { padding: 34rpx 30rpx 80rpx; background: var(--mist); }
.onboard-brand { display: flex; flex-direction: column; align-items: flex-start; margin: 28rpx 0 32rpx; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin-bottom: 16rpx; border-radius: 22rpx 22rpx 6rpx 22rpx; background: var(--water); }
.brand-title { color: var(--ink); font-size: 38rpx; font-weight: 800; }
.brand-subtitle { margin-top: 5rpx; color: var(--muted); font-size: 23rpx; }
.step-indicator { display: flex; align-items: center; gap: 10rpx; margin-bottom: 32rpx; color: var(--muted); font-size: 20rpx; }
.step-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--line); }
.step-dot.active, .step-dot.done { background: var(--water); }
.step-line { width: 52rpx; height: 2rpx; background: var(--line); }
.step-indicator text.active-step { color: var(--ink); font-weight: 700; }
.form-heading { display: flex; flex-direction: column; gap: 5rpx; margin-bottom: 24rpx; color: var(--ink); font-size: 30rpx; font-weight: 700; }
.form-subtitle { color: var(--muted); font-size: 22rpx; font-weight: 400; }
.avatar-form { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; color: var(--ink); font-size: 24rpx; }
.avatar-copy { display: flex; flex-direction: column; gap: 4rpx; }
.avatar-caption { color: var(--muted); font-size: 20rpx; }
.avatar-button { flex: 0 0 100rpx; width: 100rpx; height: 100rpx; padding: 0; overflow: hidden; border-radius: 26rpx; background: var(--soft-water); box-shadow: none; }
.avatar-image { width: 100%; height: 100%; }
.form-item { margin-bottom: 22rpx; }
.label { display: block; margin-bottom: 8rpx; color: var(--muted); font-size: 22rpx; }
.input, .picker-view { width: 100%; min-height: 88rpx; padding: 22rpx; font-size: 25rpx; }
.picker-view { display: flex; align-items: center; justify-content: space-between; }
.gender-group { display: flex; gap: 10rpx; }
.gender-option { display: flex; flex: 1; flex-direction: column; align-items: center; gap: 8rpx; padding: 18rpx 6rpx; border: 1rpx solid var(--line); border-radius: 13rpx; background: var(--paper); color: var(--muted); font-size: 21rpx; }
.gender-option.active { border-color: var(--water-lo); background: var(--soft-water); color: var(--ink); font-weight: 700; }
.notice, .form-hint { display: flex; align-items: flex-start; gap: 9rpx; padding: 14rpx; border-radius: 12rpx; background: var(--soft-water); color: var(--muted); font-size: 21rpx; }
.continue-button { width: 100%; height: 96rpx; margin-top: 30rpx; border-radius: 20rpx; }
.continue-button .button-chevron { margin-left: 8rpx; font-size: 34rpx; vertical-align: -2rpx; }
.pin-setup-step { padding-bottom: 24rpx; }
.skip-pin { margin-top: 22rpx; padding: 16rpx; color: var(--muted); text-align: center; font-size: 22rpx; }
